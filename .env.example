# local works without credentials; set firebase when ready to connect.
DATA_MODE=firebase
APP_BASE_URL=http://127.0.0.1:3000
WORKER_URL=http://127.0.0.1:3001
WORKER_PORT=3001
# Keep localhost for local use. Use 0.0.0.0 only behind authenticated HTTPS hosting.
WORKER_HOST=127.0.0.1
# Read-only, organization-wide report access. Must differ from WORKER_API_TOKEN.
REPORT_API_TOKEN=
# Separate read+write token for report annotations only. Never give this to read-only consumers.
REPORT_WRITE_TOKEN=
REPORT_EDITOR_ID=external-report-editor
# Set a long random token before running in Firebase mode.
WORKER_API_TOKEN=
SCAN_INTERVAL_MS=300000
# Public Google Firebase web app configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server only. Use separate identities for web and worker in production.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternatively use Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
LEADERSHIP_ALLOWED_EMAILS=
LEADERSHIP_NOTIFY_EMAILS=
MANAGER_ACK_SLA_HOURS=24
OVERDUE_CHECKPOINT_HOURS=24
LEADERSHIP_CHECKPOINT=3
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_DRY_RUN=true
# Mailing is explicitly disabled in the Server 2 runtime for this setup.
EMAIL_DELIVERY_ENABLED=false
EMAIL_MAX_ATTEMPTS=5
SHEETS_SYNC_TOKEN=
